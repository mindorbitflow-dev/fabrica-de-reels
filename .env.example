# API Keys Estándar
# Recomendado (gratis): https://aistudio.google.com -> guionista, temas aleatorios, inglés y búsqueda web
GEMINI_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
PEXELS_API_KEY=
# Opcional: segundo banco de video gratuito (https://pixabay.com/api/docs/)
PIXABAY_API_KEY=
# Opcional: token gratuito de https://auth.pollinations.ai para generar imágenes en paralelo (sin él, 1 a la vez)
POLLINATIONS_TOKEN=

# Publicación (se rellenan solas al conectar Meta en Ajustes)
META_PAGE_ID=
META_PAGE_TOKEN=
INSTAGRAM_USER_ID=
# Página de Facebook de noticias (en Ajustes: «Usarla como página de noticias»)
NEWS_PAGE_ID=
NEWS_PAGE_TOKEN=

# Conectar cualquier otra IA (DeepSeek, OpenRouter, Mistral, Together AI, Ollama)
CUSTOM_LLM_BASE_URL=https://api.deepseek.com/v1
CUSTOM_LLM_API_KEY=
CUSTOM_LLM_MODEL=deepseek-chat

